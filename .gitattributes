# Keep everything LF, in the index and in working copies on every platform.
* text=auto eol=lf

# Binary assets.
*.png  binary
*.jpg  binary
*.tga  binary
*.blp  binary
*.ttf  binary

# Development files left out of release archives (git archive / packager)
.github/         export-ignore
tests/           export-ignore
docs/            export-ignore
.gitattributes   export-ignore
.gitignore       export-ignore
.pkgmeta         export-ignore
